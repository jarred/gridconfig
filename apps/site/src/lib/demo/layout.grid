areas: A
name: hero
container: size

100x100:
  gap: 4
  padding: 4
  areas: |
    A A
    B B

# Keys are min-width x min-height. A larger step overrides the steps it is inside.
200x200:
  gap: 8
  rows: 2fr 1fr
  padding: 8
  areas: |
    A A
    . B

600x600:
  padding: 12
  gap: 8
  cols: 20cqh 1fr*3 20cqh
  rows: 20cqh 1fr*3 20cqh
  areas: |
    . A A . .
    . A A . .
    . . . . .
    . . . . .
    . B B B B

1024x900:
  gap: 16
  padding: 16
  areas: |
    . . . . . . . .
    A A A A . . . .
    A A A A . . . .
    . . . . . B B B
