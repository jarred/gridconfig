{
	"name": "@gridconfig/devtools",
	"version": "1.0.0",
	"description": "An in-browser inspector for GridConfig layouts: areas, tracks, the active step and markup checks.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jarred/gridconfig.git",
		"directory": "packages/devtools"
	},
	"homepage": "https://github.com/jarred/gridconfig#readme",
	"bugs": "https://github.com/jarred/gridconfig/issues",
	"keywords": [
		"gridconfig",
		"devtools",
		"inspector",
		"css",
		"grid",
		"container-queries"
	],
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./auto": "./src/auto.ts"
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public",
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"./auto": {
				"types": "./dist/auto.d.ts",
				"default": "./dist/auto.js"
			}
		}
	},
	"sideEffects": [
		"./src/auto.ts",
		"./dist/auto.js"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json && node scripts/inline-css.js",
		"prepublishOnly": "pnpm build",
		"test": "node --test \"test/**/*.test.ts\"",
		"check": "tsc -p tsconfig.json"
	},
	"dependencies": {
		"@gridconfig/core": "workspace:^"
	},
	"devDependencies": {
		"typescript": "^6.0.3"
	}
}
