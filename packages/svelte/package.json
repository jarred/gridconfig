{
	"name": "@gridconfig/svelte",
	"version": "0.0.0",
	"description": "GridConfig Grid component for Svelte 5.",
	"license": "MIT",
	"type": "module",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"svelte": "./src/index.ts",
			"default": "./src/index.ts"
		}
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public",
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"svelte": "./dist/index.js",
				"default": "./dist/index.js"
			}
		}
	},
	"scripts": {
		"build": "svelte-package -i src -o dist",
		"prepublishOnly": "pnpm build",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"test": "node --test \"test/**/*.test.ts\" && node --conditions=browser --conditions=production --test test/hydrate.dom.ts"
	},
	"dependencies": {
		"@gridconfig/core": "workspace:*",
		"@gridconfig/devtools": "workspace:*",
		"esm-env": "^1.2.2"
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@sveltejs/package": "^3.0.2",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3"
	}
}
