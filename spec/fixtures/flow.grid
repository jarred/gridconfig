# B has flow at each step. A step that sets an entry writes it in full: at 600 x 400 only 600x
# matches, so B gets no part of the ..600x400 entry.
# C has flow but is hidden from 800px.
areas: A B C
flow:
  B: column center start
  C: column

..600x400:
  flow:
    B: row end

600x:
  flow:
    B: column center

800x:
  areas: A B
  flow:
    B: none
    C: row

1000x:
  flow:
    B: row between center gap {space.2} wrap
